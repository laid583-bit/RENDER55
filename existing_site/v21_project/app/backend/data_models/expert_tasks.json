        "id": {
            "type": "integer",
            "description": "Primary key, auto-increment"
        },
        "user_id": {
            "type": "string",
            "description": "User ID"
        },
        "from_currency": {
            "type": "string",
            "description": "Source currency code"
        },
        "to_currency": {
            "type": "string",
            "description": "Target currency code"
        },
        "amount": {
            "type": "number",
