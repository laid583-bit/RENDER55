{
    "title": "currency_pairs",
    "type": "object",
    "properties": {
        "id": {
            "type": "integer",
            "description": "Primary key, auto-increment"
        },
        "base_currency": {
            "type": "string",
            "description": "Base currency code, e.g. XAU, USD, GBP"
        },
        "quote_currency": {
            "type": "string",
            "description": "Quote currency code, e.g. USD, EUR, BTC"
        },
        "pair_name": {
            "type": "string",
            "description": "Display name, e.g. XAU/USD"
        },
        "is_active": {
            "type": "boolean",
            "description": "Whether this pair is active"
        },
        "created_at": {
            "type": "string",
            "format": "date-time",
            "description": "Creation timestamp"
        }
    },
    "required": [
        "id",
        "base_currency",
        "quote_currency",
        "pair_name"
    ]
}